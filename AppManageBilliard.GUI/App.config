<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <configSections>
        <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" >
            <section name="AppManageBilliard.GUI.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
        </sectionGroup>
    </configSections>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
	<appSettings>
			<add key="BankName" value="BIDV"/>
			<add key="AccountNumber" value="7290384088"/>
			<add key="ShopName" value="Billiard Club"/>
			<add key="ShopAddress" value="123 Đường ABC, Quận X"/>
			<add key="QRNote" value="Quét mã để thanh toán"/>
	</appSettings>
    <userSettings>
        <AppManageBilliard.GUI.Properties.Settings>
            <setting name="UserName" serializeAs="String">
                <value />
            </setting>
            <setting name="PassWord" serializeAs="String">
                <value />
            </setting>
            <setting name="IsRemember" serializeAs="String">
                <value>False</value>
            </setting>
        </AppManageBilliard.GUI.Properties.Settings>
    </userSettings>
	<connectionStrings>
		<add name="QuanLyBiaString"
			 connectionString="Data Source=(LocalDB)\MSSQLLocalDB;AttachDbFilename=|DataDirectory|\QuanLyQuanBida.mdf;Integrated Security=True"
			 providerName="System.Data.SqlClient" />
	</connectionStrings>

</configuration>